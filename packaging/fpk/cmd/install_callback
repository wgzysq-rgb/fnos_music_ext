#!/bin/bash
# Run the repo installer with the wizard answers (wizard_* env vars).
set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${SELF_DIR}/_common"

[ -n "${FNMUSIC_REPO_DIR}" ] || fnmusic_fail "应用文件缺失（install.sh 不存在）"

# 音源：本机已安装时**一律沿用已安装音源**，向导值只对首次安装生效。
#
# 为什么必须这样（实测回归）：install.sh 把 FNMUSIC_MUSICDL_ENABLED /
# FNMUSIC_LX_ENABLED 当作「安装时部署选项」，永远以本次安装的值覆盖 .env；而向导字段
# wizard_sources 是 required + initValue="musicdl"。于是「应用中心重装 FPK」若走安装钩子
# （同版本重复安装/覆盖安装都走这里），用户在管理页设好的洛雪自定义源会被静默改写回
# musicdl 聚合音源。表现为：在线搜索/网易歌单还能放，但推荐歌单的曲目 id 是 lx: 形态，
# _source_enabled() 判定为未启用 → 取流 404 → App 一播就跳下一首。
# 向导字段本身叫「初始音源」，说明文案也写明「音源安装后可随时在管理页切换」，所以重装
# 不该覆盖用户的选择。想换音源：在管理页切换；或先卸载再安装（卸载会清掉快照，向导值生效）。
SOURCES="${wizard_sources:-}"
case "${SOURCES}" in
    musicdl|musicbox|lxmusic) ;;
    *) SOURCES="" ;;
esac
INSTALLED_SOURCES="$(fnmusic_snapshot_source)"
INHERITED=0
if [ -n "${INSTALLED_SOURCES}" ]; then
    INHERITED=1
    if [ -n "${SOURCES}" ] && [ "${SOURCES}" != "${INSTALLED_SOURCES}" ]; then
        {
            echo "[fnmusic-ext] 向导选择 ${SOURCES}，本机已安装音源为 ${INSTALLED_SOURCES}："
            echo "沿用已安装音源（如需切换请在管理页操作，或先卸载再安装）"
        } >> "${FNMUSIC_DURABLE_LOG}" 2>/dev/null || true
        echo "[fnmusic-ext] 沿用已安装音源 ${INSTALLED_SOURCES}（忽略向导的 ${SOURCES}）" \
            >> "${FNMUSIC_LOG}" 2>&1 || true
    fi
    SOURCES="${INSTALLED_SOURCES}"
elif [ -z "${SOURCES}" ]; then
    SOURCES="musicdl"
fi

EXTEND="${wizard_extend:-true}"
case "${EXTEND}" in
    true|True|TRUE|1|yes) EXTEND=1 ;;
    *) EXTEND=0 ;;
esac

# 1. 宿主机失效代理 unit 预清理（老部署换目录/换卷自愈）
FNMUSIC_UNIT_FILE="${FNMUSIC_UNIT_FILE:-/etc/systemd/system/fnmusic-ext.service}"
if [ -f "${FNMUSIC_UNIT_FILE}" ]; then
    unit_wd="$(sed -n 's/^[[:space:]]*WorkingDirectory=//p' "${FNMUSIC_UNIT_FILE}" | head -n1)"
    unit_wd_real="$(readlink -f -- "${unit_wd}" 2>/dev/null || true)"
    repo_real="$(readlink -f -- "${FNMUSIC_REPO_DIR}" 2>/dev/null || true)"
    if [ -z "${unit_wd_real}" ] || [ "${unit_wd_real}" != "${repo_real}" ]; then
        systemctl stop fnmusic-ext.service >> "${FNMUSIC_LOG}" 2>&1 || true
        rm -f "${FNMUSIC_UNIT_FILE}"
        systemctl daemon-reload >> "${FNMUSIC_LOG}" 2>&1 || true
        echo "[fnmusic-ext] 已清理指向 ${unit_wd:-未知路径} 的历史代理 unit" >> "${FNMUSIC_LOG}" 2>&1
    fi
fi

# 2. 存量手动/老目录部署数据平滑继承（.env/登录凭据/收藏/历史）
DEPLOYMENT_FILE="${FNMUSIC_DEPLOYMENT_FILE:-/var/lib/fnmusic-ext/deployment}"
if [ -f "${DEPLOYMENT_FILE}" ]; then
    OLD_BASE="$(sed -n 's/.*"base"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "${DEPLOYMENT_FILE}" | head -n1)"
    if [ -n "${OLD_BASE}" ] && [ -d "${OLD_BASE}" ] && [ "$(readlink -f -- "${OLD_BASE}")" != "$(readlink -f -- "${FNMUSIC_REPO_DIR}")" ]; then
        for item in .env sources-data online_favorites online_favorites.json play_history; do
            if [ -e "${OLD_BASE}/${item}" ] && [ ! -e "${FNMUSIC_REPO_DIR}/${item}" ]; then
                cp -a "${OLD_BASE}/${item}" "${FNMUSIC_REPO_DIR}/" 2>/dev/null || true
                echo "[fnmusic-ext] 已从原部署 (${OLD_BASE}) 平滑继承数据: ${item}" >> "${FNMUSIC_LOG}" 2>&1
            fi
        done
    fi
fi

# 3. 组装安装参数：应用中心安装天然代表确立整机唯一部署，始终追加 --adopt
ARGS=(--non-interactive --sources "${SOURCES}" --webui --adopt)
# 洛雪源脚本（URL/电脑上传/NAS 选择）统一装好后在管理页 WebUI 配置：
# 安装向导平台没有文件上传组件，URL 也不再向安装者索要，无源安装不阻塞。
if [ -n "${wizard_lx_url:-}" ]; then
    # 兼容旧版向导写入的向导值（升级场景等）：有值就透传，无值不要求
    ARGS+=(--lx-source-url "${wizard_lx_url}")
fi
# 沿用已安装的洛雪源时与 upgrade_callback 对齐：带上已保存的源地址，并跳过可用性校验
# ——源是用户装机时已确认过的，重装不该因源服务器临时故障而中止安装（非交互模式下
# 校验失败会直接中止）。可用性照旧可在管理页查看/重配。
if [ "${INHERITED}" -eq 1 ] && [ "${SOURCES}" = "lxmusic" ]; then
    INHERITED_LX_URL="$(fnmusic_saved_lx_url)"
    [ -n "${INHERITED_LX_URL}" ] && ARGS+=(--lx-source-url "${INHERITED_LX_URL}")
    ARGS+=(--lx-skip-verify)
fi
[ "${EXTEND}" -eq 1 ] && ARGS+=(--extend)

cd "${FNMUSIC_REPO_DIR}"
if ! fnmusic_run_logged bash ./install.sh "${ARGS[@]}"; then
    # 安装失败后应用中心会回滚删除 TRIM_PKGVAR（fnmusic-app.log 随之消失）。
    # 过程输出已在 FNMUSIC_DURABLE_LOG，弹窗带上该路径和错误行。
    # 回滚不删 compose 容器，这里先清掉，避免空挂载孤儿占名。
    fnmusic_cleanup_sources_container
    fnmusic_fail_from_log "安装失败"
fi

exit 0
