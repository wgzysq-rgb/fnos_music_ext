#!/bin/bash
# Shared helpers for fnmusic-ext App Center lifecycle scripts (sourced, not run).
# The sourcing script must set SELF_DIR to its own directory first.

FNMUSIC_APP_ROOT="$(cd "${SELF_DIR}/.." && pwd)"
# cmd/ lives at /var/apps/fnmusic-ext/cmd; the repo payload lands at target/repo
# (TRIM_APPDEST may point at either root depending on fnOS version).
FNMUSIC_REPO_DIR=""
for _cand in "${TRIM_APPDEST:-}/repo" "${FNMUSIC_APP_ROOT}/target/repo" "${FNMUSIC_APP_ROOT}/repo"; do
    if [ -n "${_cand}" ] && [ -f "${_cand}/install.sh" ]; then
        FNMUSIC_REPO_DIR="$(cd "${_cand}" && pwd)"
        break
    fi
done
unset _cand

FNMUSIC_LOG="${TRIM_PKGVAR:-/tmp}/fnmusic-app.log"
mkdir -p "$(dirname "${FNMUSIC_LOG}")" 2>/dev/null || true

# 应用中心安装失败会回滚删除 TRIM_PKGVAR，fnmusic-app.log 会一起消失。
# 过程输出同时追加到这份不随回滚删除的日志。测试用 FNMUSIC_DURABLE_LOG 覆盖。
if [ -z "${FNMUSIC_DURABLE_LOG:-}" ]; then
    FNMUSIC_DURABLE_LOG="/var/log/apps/fnmusic-ext-install.log"
    if ! { mkdir -p /var/log/apps && touch "${FNMUSIC_DURABLE_LOG}"; } 2>/dev/null; then
        FNMUSIC_DURABLE_LOG="/tmp/fnmusic-ext-install.log"
    fi
fi
mkdir -p "$(dirname "${FNMUSIC_DURABLE_LOG}")" 2>/dev/null || true
touch "${FNMUSIC_DURABLE_LOG}" 2>/dev/null || true
chmod a+r "${FNMUSIC_DURABLE_LOG}" 2>/dev/null || true

fnmusic_fail() {
    # Short, actionable message surfaced in the App Center progress UI.
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        echo "$1" > "${TRIM_TEMP_LOGFILE}" || true
    fi
    echo "[fnmusic-ext] $1" >&2
    exit 1
}

fnmusic_error_brief() {
    # Installer [ERROR] lines for the App Center popup. BuildKit prints the
    # whole RUN script as a step title; if that script contains echo "[ERROR]",
    # a naive grep matches the title and the 300-char popup becomes fix_dns.
    local log="${1:-${FNMUSIC_LOG}}"
    [ -f "${log}" ] || return 0
    sed $'s/\x1b\\[[0-9;]*m//g' "${log}" 2>/dev/null \
        | grep -a '\[ERROR\]' \
        | grep -avE '\[ [0-9]+/[0-9]+\] RUN ' \
        | tail -n 5 \
        | tr '\n' ' ' \
        | { python3 -c 'import sys; sys.stdout.write(sys.stdin.read()[:400])' 2>/dev/null || cut -c1-400; }
}

fnmusic_log_tail_brief() {
    # Last lines when the installer exited without an [ERROR] marker
    # (for example set -e on a command that prints nothing).
    local log="${1:-${FNMUSIC_LOG}}"
    [ -f "${log}" ] || return 0
    sed $'s/\x1b\\[[0-9;]*m//g' "${log}" 2>/dev/null \
        | tail -n 5 \
        | tr '\n' ' ' \
        | { python3 -c 'import sys; sys.stdout.write(sys.stdin.read()[:300])' 2>/dev/null || cut -c1-300; }
}

fnmusic_run_logged() {
    # Run a command, appending a timestamped copy of its combined output to
    # FNMUSIC_DURABLE_LOG. The return status is the command's, not tee's.
    local stamp rc pipefail_on=0
    stamp="$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo unknown-time)"
    printf '\n===== %s %s =====\n' "${stamp}" "$*" >> "${FNMUSIC_DURABLE_LOG}" 2>/dev/null || true
    if set -o | grep -q 'pipefail[[:space:]]*on'; then
        pipefail_on=1
    fi
    set +o pipefail
    "$@" 2>&1 | tee -a "${FNMUSIC_DURABLE_LOG}" >> "${FNMUSIC_LOG}"
    rc=${PIPESTATUS[0]}
    if [ "${pipefail_on}" -eq 1 ]; then
        set -o pipefail
    fi
    return "${rc}"
}

fnmusic_fail_from_log() {
    # $1 is the short prefix ("安装失败" / "升级失败……"). Popup keeps the
    # durable path first so rollback of TRIM_PKGVAR cannot hide the log.
    local prefix="$1" err_brief
    err_brief="$(fnmusic_error_brief)"
    if [ -z "${err_brief}" ]; then
        err_brief="$(fnmusic_log_tail_brief)"
    fi
    tail -n 5 "${FNMUSIC_LOG}" >&2 || true
    fnmusic_fail "${prefix}。日志：${FNMUSIC_DURABLE_LOG}。${err_brief:-未捕获到错误行}"
}

fnmusic_cleanup_sources_container() {
    # App Center rolls back TRIM_PKGVAR / target on install failure but does
    # not remove the compose container; an empty-mount orphan then occupies
    # the global name fnmusic-sources.
    docker rm -f fnmusic-sources >/dev/null 2>&1 || true
}

fnmusic_env_source() {
    # 0 when the selected audio source recorded in .env is enabled.
    #
    # 注意 .env 的值一律是单引号包裹的（install.sh 与 WebUI 都经
    # env_merge.quote_env_value 写出：FNMUSIC_LX_ENABLED='true'）。此前这里只认裸
    # KEY=true —— 真实 .env 永远匹配不上，fnmusic_saved_source() 因而恒为空，
    # 升级/重装一律回落 musicdl 聚合音源，把用户在管理页选好的洛雪自定义源静默重置
    # （推荐歌单曲目 id 是 lx: 形态 → 取流 404 → App 一播就跳下一首）。
    # 这里统一剥离 export 前缀 / 引号 / 空白再比对，单引号、双引号、裸值都兼容。
    [ -n "${FNMUSIC_REPO_DIR}" ] && [ -f "${FNMUSIC_REPO_DIR}/.env" ] || return 1
    local key="$1" raw
    raw="$(sed -n "s/^[[:space:]]*export[[:space:]]*${key}=//p;s/^[[:space:]]*${key}=//p" \
        "${FNMUSIC_REPO_DIR}/.env" 2>/dev/null | tail -n1 \
        | tr -d "'\"[:space:]" | tr '[:upper:]' '[:lower:]')"
    case "${raw}" in
        true|1|yes) return 0 ;;
        *) return 1 ;;
    esac
}

fnmusic_saved_source() {
    # Map the flags written by install.sh back to a --sources value.
    if fnmusic_env_source FNMUSIC_NETEASE_ENABLED; then echo musicbox
    elif fnmusic_env_source FNMUSIC_LX_ENABLED; then echo lxmusic
    elif fnmusic_env_source FNMUSIC_MUSICDL_ENABLED; then echo musicdl
    else echo ""; fi
}

fnmusic_saved_lx_url() {
    # 同样必须剥引号：带引号的值作为 --lx-source-url 传给 install.sh 时不匹配
    # http(s):// / file:// 分支，会被当成「本机 .js 文件路径」→ [ ! -f ... ] →
    # log_err 并直接中止升级/安装。
    [ -f "${FNMUSIC_REPO_DIR}/.env" ] || return 0
    sed -n "s/^[[:space:]]*export[[:space:]]*LX_SOURCE_URL=//p;s/^[[:space:]]*LX_SOURCE_URL=//p" \
        "${FNMUSIC_REPO_DIR}/.env" 2>/dev/null | tail -n1 | tr -d "'\"[:space:]"
}

# --- 已安装音源的持久快照 ---------------------------------------------------
# 应用中心重装/升级会重建 target/，repo/.env（音源记录所在）可能先被清掉，而
# FNMUSIC_MUSICDL_ENABLED / FNMUSIC_LX_ENABLED 属于 install.sh 的「安装时部署选项」
# （始终以本次安装的值覆盖 .env）。两者叠加就会把用户在管理页设好的音源静默重置回
# musicdl 聚合音源。快照放在应用目录之外，重装时才能沿用用户此前的选择。
# FNMUSIC_SOURCE_SNAPSHOT 仅供测试注入；生产路径固定 /var/lib/fnmusic-ext。

fnmusic_source_snapshot_path() {
    echo "${FNMUSIC_SOURCE_SNAPSHOT:-/var/lib/fnmusic-ext/installed-source}"
}

fnmusic_write_source_snapshot() {
    local value="$1" path
    case "${value}" in
        musicdl|musicbox|lxmusic) ;;
        *) return 0 ;;
    esac
    path="$(fnmusic_source_snapshot_path)"
    mkdir -p "$(dirname "${path}")" 2>/dev/null || return 0
    printf '%s\n' "${value}" > "${path}" 2>/dev/null || true
}

fnmusic_snapshot_source() {
    # 已安装音源：优先 .env（管理页切源即写这里，最新），其次持久快照（重装后被清 .env 时兜底）。
    local saved
    saved="$(fnmusic_saved_source)"
    if [ -z "${saved}" ]; then
        local path
        path="$(fnmusic_source_snapshot_path)"
        [ -f "${path}" ] && saved="$(head -n1 "${path}" 2>/dev/null | tr -d '[:space:]')"
    fi
    case "${saved}" in
        musicdl|musicbox|lxmusic) echo "${saved}" ;;
        *) echo "" ;;
    esac
}

fnmusic_clear_source_snapshot() {
    # 卸载即清空安装期状态：重装（先卸载）应回到向导的初始音源选择。
    rm -f "$(fnmusic_source_snapshot_path)" 2>/dev/null || true
}

fnmusic_data_items() {
    # User data living inside the repo dir (relative paths, existing ones only).
    # 在仓库目录内展开通配：调用方 cwd 若也有 .env.bak*，tar -C repo ${ITEMS}
    # 会按 cwd 展开，把不存在于 repo 的文件名传给 tar 导致备份失败。
    local p f rel items=""
    [ -n "${FNMUSIC_REPO_DIR}" ] || return 0
    for p in ".env" ".env.bak*" "sources-data" "online_favorites" "online_favorites.json" "play_history"; do
        # shellcheck disable=SC2086
        for f in "${FNMUSIC_REPO_DIR}"/${p}; do
            [ -e "${f}" ] || continue
            rel="${f#"${FNMUSIC_REPO_DIR}"/}"
            items="${items} ${rel}"
        done
    done
    echo "${items# }"
}
