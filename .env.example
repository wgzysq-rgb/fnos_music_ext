# 复制为 .env 后填写（安装向导会自动生成并维护此文件，一般无需手抄）：
#   cp .env.example .env && chmod 600 .env
# 改动标注「热重载」的键后无需重启，代理约 2 秒内自动生效；
# 其余键（路径/端口/容器白名单类）改动后需重跑 ./install.sh 或 ./extend.sh。

FNMUSIC_HOME=

# ── 音源三选一（v2.0.0 起互斥单选：三个开关只能一个为 true）──────────────
# 运行期切换音源推荐直接在飞牛管理员打开的管理页操作：
# 写配置 + 秒级切换进程一步完成。手动改此文件后需重启容器（./extend.sh）。
#   musicdl: https://github.com/CharlesPikachu/musicdl 酷我/咪咕等 56 平台聚合
#   musicbox: https://github.com/darknessomi/musicbox 网易云（支持扫码登录 VIP）
#   lxmusic: 洛雪自定义源运行时（播放解析使用你自己的源脚本，见下方 LX_SOURCE_URL）
FNMUSIC_MUSICDL_ENABLED=false
FNMUSIC_NETEASE_ENABLED=false
FNMUSIC_LX_ENABLED=true
FNMUSIC_MUSICDL_URL=http://127.0.0.1:8768
FNMUSIC_MUSICBOX_URL=http://127.0.0.1:8770
FNMUSIC_LX_URL=http://127.0.0.1:8772

# ── musicdl 平台白名单（仅 musicdl 源生效）────────────────────────────
# 短名或全名均可；install.sh --sources musicdl-<平台> 或向导选择后写入。
# 全部平台编号见 musicdl-service/PLATFORMS.md。
FNMUSIC_ONLINE_SOURCES=MiguMusicClient,KuwoMusicClient
MUSICDL_SOURCES=KuwoMusicClient,MiguMusicClient

# ── 洛雪自定义源（仅 lxmusic 源生效）──────────────────────────────────
# 源脚本地址：http(s) URL 或 file:///data/lxmusic/uploads/<文件>.js（上传脚本）。
# 留空表示尚未配置（搜索/榜单仍可用，播放解析不可用）。
# 推荐在 WebUI「音乐源 → 洛雪自定义源」配置：粘贴 URL / 上传电脑 .js / 从 NAS 选择，
# 测试可用后保存即激活；install.sh --lx-source-url 也支持本机 .js 路径（自动复制进数据卷）。
LX_SOURCE_URL=
# 洛雪自定义源脚本列表（JSON 格式，由管理台维护）
LX_SOURCE_LIST='[]'
# lx 启用的平台（kg 酷狗 / wy 网易 / mg 咪咕 / kw 酷我 / tx QQ）
LX_SOURCES=kg,wy,mg,kw
LX_SEARCH_TIMEOUT=12
LX_LIMIT_PER_SOURCE=20
# 单次 musicUrl 解析预算（秒）：洛雪源多为二级转发，4s 会掐死慢源；12 为实测水位
LX_RESOLVER_TIMEOUT=12.0
# lxserver release 预编译包镜像加速地址（仅在未预置离线包并从源码构建 Docker 镜像时使用，可选）
# LXSERVER_MIRROR=https://ghfast.top

# ── 管理 WebUI ────────────────────────────────────────────────────────
# 启用后由已登录的飞牛管理员打开（桌面「fnMusic 扩展管理」或 /app/fnmusic-ext）。
# 容器按需启动：关闭时 WebUI 进程不驻留内存。端口只发布在本机。
FNMUSIC_WEBUI_ENABLED=true

# ── 音质偏好（热重载）─────────────────────────────────────────────────
# high     优先最高可用音质（默认，从高到低尝试）
# balanced 平衡档位（取中间；偶数档取中间偏高；失败先向下再向上）
# smooth   流畅优先（从最低可用音质开始，最省带宽）
FNMUSIC_QUALITY_MODE=high

# ── 边听边存 ──────────────────────────────────────────────────────────
# 开关（默认开）：完整试听一首在线歌后自动保存为本地曲库文件；
# 保存路径留空=自动探测飞牛官方共享曲库目录，配置后以配置为准，
# 路径不可用（无法创建/不可写）自动回退默认；
# 关闭开关时仅滚动缓存最新 FNMUSIC_TEE_CACHE_MAX 首试听（该数量仅在关闭时生效），
# restore 还原时会一并清理这些滚动缓存。
# 听歌过程中切歌/退出不中断下载：未下完的文件自动转后台断点续传完成。
# FNMUSIC_TEE_HANDOFF_MAX 限制并行续传任务数（防快速跳歌形成下载洪泛；0=关闭续传）。
FNMUSIC_TEE_SAVE_ENABLED=true
FNMUSIC_TEE_SAVE_DIR=
# 飞牛音乐曲库 db（边听边存落盘目标由它反查出来）。
# 注意：应用中心（fpk）安装时，拦截代理跑在 NAS 宿主机上，宿主视角的真实
# 路径形如 /vol1/@appdata/trim.music/db/music.db；而代码默认值是官方音乐
# App「容器内视角」的 /usr/local/apps/@appdata/... —— 在宿主机上不存在。
# 2.7.9 起默认值落空会自动按 /vol*/@appdata/trim.music/db/ 探测并打日志
# （「曲库自动探测命中：music.db=...」）；自动探测也找不到时在这里写死：
# FNMUSIC_MUSIC_DB=/vol1/@appdata/trim.music/db/music.db
# 或直接指定共享曲库目录（优先级最高）：
# FNMUSIC_LIBRARY_DIR=/vol1/1000/music
FNMUSIC_TEE_CACHE_MAX=2
FNMUSIC_TEE_HANDOFF_MAX=3
# 自动下载封面（默认开，热重载）：自动保存到本地的歌曲（边听边存 / 收藏自动
# 绑定本地的后台下载）在文件完整落库后，顺带把源站封面下载并内嵌进音频文件。
# 飞牛音乐只认音频内嵌封面（不支持 cover.jpg 等外置图片文件），内嵌后官方
# App 里下载的歌才有封面图；封面在歌曲保存成功后才处理，不产生独立封面文件。
FNMUSIC_AUTO_COVER=true
# 封面代理缓存（默认开，热重载）：在线歌曲封面由扩展代取并缓存到 NAS 本地，
# 浏览器直接加载本地文件。修复「手机 App 封面正常、电脑网页封面经常加载不出来」
# ——浏览器（Chrome 86+）会对 http 封面直链做 mixed-content 自动升级，CDN 不支持
# https 时图片被静默丢弃（手机 App 不受此限制）。代理失败自动回落 302 直链。
# FNMUSIC_COVER_CACHE_DIR 留空 = <cache>/covers；FNMUSIC_COVER_CACHE_MAX 缓存
# 文件数上限（超出按最旧淘汰，默认 2000）。
FNMUSIC_COVER_PROXY=true
# FNMUSIC_COVER_CACHE_DIR=
# FNMUSIC_COVER_CACHE_MAX=2000
# 飞牛官方封面根目录（空=自动探测 /vol*/@appmeta/trim.music/cover，热重载）：
# 代理处理本地歌曲封面请求时直读该目录中的官方封面资源文件，避开 UDS 透传
# 与鉴权开销，大幅提升列表图片加载性能；未命中时自动落回官方上游透传。
# FNMUSIC_COVER_DIR=
# 自动下载歌词（默认关，热重载）：边听边存开启时，自动保存到本地的歌曲在文件
# 完整落库成功后，自动下载同名 .lrc 歌词放到歌曲同一个文件夹（飞牛音乐扫描
# 入库后播放即可显示歌词）。歌词在歌曲保存成功后才下载，且先于曲库扫描完成，
# 不产生只有歌词没有歌的孤儿文件。网易云/酷狗/咪咕/QQ 支持，酷我源免登录
# 歌词接口已失效暂无歌词，musicdl 聚合源视平台而定。
FNMUSIC_LYRIC_AUTO_DL=false
# 收藏/加入歌单自动绑定本地（默认关）：收藏或加歌单的在线歌曲先立即生效，随后
# 后台自动下载到本地曲库；官方曲库收录该文件后，自动把这次收藏/加歌单写进飞牛
# 官方的收藏/歌单列表（成功后删除本地映射，只在官方列表显示一次；官方未收录前
# 保留本地映射兜底，打开收藏/歌单列表时自动重试）。与边听边存不重复下载。
FNMUSIC_FAV_AUTO_BIND=false
# 官方绑定轮询窗口（秒，10-3600，热重载）：下载落库后等待官方扫入库并完成
# 官方写入的时间上限，超时保留本地映射待自愈重试。
FNMUSIC_OFFICIAL_BIND_TIMEOUT_S=120
# 落盘进曲库后通知官方重扫的接口路径（POST）；空=禁用（官方通常自动扫描入库）。
# 官方无公开文档：真机在官方 App 手动点一次扫描、从代理请求日志
# （FNMUSIC_TRACE_FORWARD=detail）捕获真实路径后填入可加速官方入库。
FNMUSIC_LIBRARY_SCAN_PATH=

# ── 推荐歌单开关（两个独立歌单，热重载）──────────────────────────────
# 热门推荐：独立歌单，内容为榜单原味（musicbox 热歌榜 / lxmusic 榜单），
#           榜单全部不可用时不显示该歌单。
# 每日推荐：按账户隔离。网易每日推荐每天仅第一个打开的用户使用；
#           其余用户依次走大模型（配置了下方 FNMUSIC_LLM_* 即启用）、
#           本地曲库随机兜底（最近没听过的本地现存曲目，各账户不同）。
# 两个歌单封面都取列表里第一首带可用封面的曲目；全无封面时不显示图标。
FNMUSIC_RECOMMEND_HOT=true
FNMUSIC_RECOMMEND_DAILY=true

# ── 平台推荐歌单（发现·歌单广场，热重载）─────────────────────────────
# 把「各平台推荐歌单」注入到歌单列表（与柠檬音乐发现页同源：QQ 歌单广场 /
# 网易 playlist/list / 酷我 getRcmPlayList / 酷狗 getSpecial / 咪咕歌单广场）。
# 每张卡点进去拉该平台歌单曲目，曲目走已激活的洛雪源播放（与搜索栏在线结果
# 同款前提：洛雪源需处于激活状态）。属公共内容，不读个人历史/收藏。
# 开关：true 时按下方平台白名单注入；false（默认）完全不注入。
FNMUSIC_RECOMMEND_PLAYLIST=false
# 平台白名单（逗号分隔，可选项 tx/wy/kw/kg/mg）；**留空 = 不注入任何平台**。
#   总开关 FNMUSIC_RECOMMEND_PLAYLIST=true 但这里留空时，不会注入任何推荐歌单。
FNMUSIC_RECOMMEND_PLAYLIST_SOURCE=
# 歌单分类筛选（逗号分隔，格式 <平台>:<分类id>，如 tx:165,tx:6,kg:12）；
#   留空 = 各平台「全部」，与原行为一致。勾选多个分类时，每个分类各取
#   PAGE_SIZE 条后按歌单 id 合并去重。分类 id 可在管理页「歌单分类」里查看。
#   咪咕（mg）无分类体系，不参与筛选。改动经 .env 热重载即时生效。
FNMUSIC_RECOMMEND_PLAYLIST_CATEGORY=
# 每平台注入的歌单卡数量（1-30）。歌单列表会被平台卡填充，按需调小。
# 注意：勾选 N 个分类时，该平台总卡数约为 N × PAGE_SIZE（跨分类去重后）。
FNMUSIC_RECOMMEND_PLAYLIST_PAGE_SIZE=12

# ── 推荐构建行为（issue #23/#29，热重载）──────────────────────────────
# 总预算（秒，10-180）：单次"每日/热门推荐"生成的最长时间。每解析成功一首
#   即渐进上架（列表出现时至少有一首歌），超时只丢后续候选不丢已完成部分。
#   预算耗尽后本地曲库随机兜底层仍会执行（只读本地库，无网络开销）。
# 候选数（10-60）：LLM 链的候选歌曲数量。
# 逐首可播校验：每首入列前解析直链+头部探活，失败换下一候选（true 默认开；
#   极慢网络可关闭换取生成速度，但列表里可能出现无法播放的曲目）。
FNMUSIC_RECOMMEND_BUDGET_S=40
FNMUSIC_RECOMMEND_CANDIDATES=36
FNMUSIC_RECOMMEND_VERIFY_PLAYABLE=true
FNMUSIC_RECOMMEND_VERIFY_TIMEOUT_S=8

# ── 封面补全（热重载）─────────────────────────────────────────────────
# musicdl/lx 搜索结果缺封面时，用网易曲库同名曲补全（true 默认开）。
# 曲目封面无论开关如何都有本地占位图兜底，永不返回 404；
# 推荐歌单封面例外：歌单内全部曲目无封面时返回 404（不显示图标）。
FNMUSIC_COVER_ENRICH=true

# ── .env 热重载总开关 ─────────────────────────────────────────────────
# 开启（默认）时代理每 2 秒检测 .env 变化，白名单键自动生效；
# 关闭后所有配置改动需重启服务。
FNMUSIC_ENV_WATCH=true

# ── 大模型每日推荐（热重载）──────────────────────────────────────────
# 三键齐全时生效；留空即完全禁用。按账户隔离：每天第一个用户用网易每日推荐
# （音源可用时），其余用户的每日推荐走大模型（种子取各自播放历史与收藏）。
# FNMUSIC_LLM_TIMEOUT_S：单次 LLM 请求超时（秒，5-60，默认 20）。
FNMUSIC_LLM_BASE_URL=
FNMUSIC_LLM_API_KEY=
FNMUSIC_LLM_MODEL=gpt-4o-mini
# FNMUSIC_LLM_TIMEOUT_S=20

# ── 搜索行为 ──────────────────────────────────────────────────────────
# 在线搜索超时（秒）。有结果立刻返回；到点还没有就只返回本地歌曲。管理页可改。
FNMUSIC_SEARCH_TIMEOUT=15
FNMUSIC_SEARCH_CACHE_TTL=604800
# 搜索深分页（热重载，管理页可改）：翻页越过在线首屏池时向音源增量取下一页
# 把本页在线段填满（本地结果始终排最前），直到上游取尽或页数封顶。
# musicdl 库无分页参数，只参与首屏聚合，不参与深分页。
FNMUSIC_SEARCH_DEEP_PAGE=true
# 每个关键词向单个音源最多取多少页（含首屏，1-50）
FNMUSIC_SEARCH_DEEP_MAX_PAGES=10
# 逐曲探活（beta，热重载，管理页可改）：在线结果逐首探测直链可用性，
# 过滤掉取不到流的条目。更准但更慢（每首一次 HEAD/GET 探测），默认关。
FNMUSIC_SEARCH_PROBE=false

# ── 网易账号歌单（热重载）─────────────────────────────────────────────
# 需 FNMUSIC_NETEASE_ENABLED=true 且已扫码登录。开启后网易账号里自己创建的
# 歌单（含"我喜欢的音乐"）以只读虚拟歌单出现在音乐页：热门推荐下方、官方
# 歌单上方；收藏的他人歌单不显示。加歌/移歌/删除不回写网易。管理页可改。
FNMUSIC_NETEASE_MY_PLAYLISTS=false

# ── Docker 构建（安装器维护）──────────────────────────────────────────
# 基础镜像：留空时安装自动探测（国内镜像优先直连绕开 daemon 加速器，
# 官方源兜底）并缓存到此键；也可手动指定，例如
#   docker.m.daocloud.io/library/python:3.13-slim
FNMUSIC_BASE_IMAGE=
# 容器内 pip 源（默认腾讯云；pip 走 HTTP/1.1，腾讯云不限速）
FNMUSIC_PIP_INDEX=https://mirrors.tencent.com/pypi/simple/
# 容器内 apt 源（默认腾讯云；apt 走 HTTP/1.1，腾讯云不限速；仅构建层临时替换+失败自动回退官方源）
FNMUSIC_APT_MIRROR=https://mirrors.tencent.com
# pip 备用源链（空格分隔，主源失败后按序重试，官方 PyPI 已内置沉底）。
# 留空 = 用 Dockerfile 内默认（阿里云→清华→腾讯云→官方 PyPI）。
# ⚠️ 注意：compose 用 ${VAR:-} 展开空值会以空串覆盖 Dockerfile 的 ARG 默认值，
# 因此本项默认不在 docker-compose.yml 透传，需要自定义时请在构建前改写
# docker-compose.yml 的 build.args 并显式填入非空值（或在容器外预先 pip 安装）。
FNMUSIC_PIP_FALLBACK_INDEXES=
# apt 备用镜像链（空格分隔，主源失败后按序重试，官方源已内置沉底）。
# 留空 = 用 Dockerfile 内默认（阿里云→清华）；填「镜像站根地址」而非完整路径。
FNMUSIC_APT_FALLBACK_MIRRORS=
# 自动探测时的国内镜像候选列表（空格分隔，按序尝试）
FNMUSIC_DOCKER_MIRRORS=docker.1ms.run docker.m.daocloud.io docker.1panel.live hub.rat.dev

FNMUSIC_DEPLOY_MODE=docker
